# Base URL of the environment under test
BASE_URL=https://commerce-parliament.myscheme.in

# Dev sign-in emails for each role genuinely exercised by the suite.
# The portal's current "Dev sign-in" screen only asks for an email (no password) -
# these values are still supplied via env vars, never hardcoded, so the framework
# can move to a real credential/SSO flow later by changing only auth.setup.ts.
SUPER_ADMIN_EMAIL=parliament-admin-user@gmail.com
SECRETARY_EMAIL=secretary@gmail.com
JOINT_SECRETARY_MULTI_DIVISION_EMAIL=joint-secretary1@gmail.com
DIVISION_USER_EMAIL=divisionuser@gmail.com

# Used only for a one-off, no-storageState RBAC check (Settings visibility) -
# does not get its own storageState file since nothing else needs this role.
PARLIAMENT_USER_EMAIL=parliament-user@gmail.com
